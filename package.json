{
  "name": "raid-site-2",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:web": "tsc --noEmit && vite build",
    "desktop": "npm run build:web && electron .",
    "dist:win": "npm run build:web && electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "phaser": "^4.2.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "main": "electron/main.cjs",
  "description": "RAID SITE 2: a real-time top-down looter shooter",
  "author": "TheLegendBoss",
  "build": {
    "appId": "com.thelegendboss.raidsite2",
    "productName": "RAID SITE 2",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "artifactName": "raid-site-2-${version}.${ext}",
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "raid-site-2-${version}-portable.${ext}"
    }
  }
}
